# ─────────────────────────────────────────────────────────────────────────────
# GESTOR DE OPERACIONES Y MOTORIZADOS — Variables de Entorno
# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA cometas .env.local al repositorio.
# Las variables con prefijo VITE_ son expuestas al navegador (seguras para el cliente).
# Las variables SIN prefijo VITE_ son solo para Edge Functions / servidor.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (PÚBLICAS — anon key no es un secreto, es diseñada para el cliente) ─
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Dónde obtenerla: Supabase Dashboard → Project Settings → API → Project URL
# Tipo: pública

VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Dónde obtenerla: Supabase Dashboard → Project Settings → API → Project API keys → anon public
# Tipo: pública (protegida por RLS en base de datos)

# ── Aplicación ────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
# URL base de la aplicación. En producción: https://ops.tudominio.com
# Dónde configurarla: proveedor de hosting (Vercel, Netlify, etc.)
# Tipo: pública

VITE_APP_NAME=GestorOps
# Nombre de la aplicación mostrado en la interfaz y título del navegador
# Tipo: pública

VITE_APP_ENV=development
# Entorno activo: development | staging | production
# Controla comportamiento de logs, seeds y herramientas de desarrollo
# Tipo: pública

# ── Zona horaria ──────────────────────────────────────────────────────────────
VITE_DEFAULT_TIMEZONE=America/Managua
# Zona horaria principal de operación (UTC-6, sin horario de verano)
# Tipo: pública

# ── Mapas (OPCIONAL — v1 usa solo apertura de URLs externas) ─────────────────
# VITE_GOOGLE_MAPS_API_KEY=
# Solo requerida si se implementa mapa embebido en v2+
# Dónde obtenerla: Google Cloud Console → APIs & Services → Credentials
# Tipo: pública (restringida por dominio en Google Cloud)

# ── PDF (OPCIONAL — si se usa servicio externo en Fase 7) ────────────────────
# VITE_PDF_SERVICE_URL=
# Solo si la generación de PDF se delega a un servicio externo
# Tipo: pública (URL del servicio, sin credenciales)

# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  SECRETAS — SOLO EN SERVIDOR / EDGE FUNCTIONS (NUNCA con prefijo VITE_)
# ─────────────────────────────────────────────────────────────────────────────
# Las siguientes variables NO deben tener el prefijo VITE_
# Solo se configuran en el entorno de servidor de Supabase Edge Functions

# SUPABASE_SERVICE_ROLE_KEY=
# Clave de servicio con acceso total, sin RLS. NUNCA al frontend.
# Dónde obtenerla: Supabase Dashboard → Project Settings → API → service_role secret
# Dónde configurarla: Supabase Dashboard → Edge Functions → Secrets
# Tipo: SECRETA

# SUPABASE_JWT_SECRET=
# Para validar tokens JWT en funciones de servidor
# Dónde obtenerla: Supabase Dashboard → Project Settings → API → JWT Settings
# Tipo: SECRETA
